  (text "ADS1115 16-bit ADC"
    (at 25.4 35.56 0)
    (effects
      (font
        (size 2.54 2.54) bold)
      (justify left top))
    (uuid "e39983c0-66f3-5c2e-8f25-8d9361d926e4"))
  (text "LSM6DSO IMU"
    (at 25.4 86.36 0)
    (effects
      (font
        (size 2.54 2.54) bold)
      (justify left top))
    (uuid "25bc1c96-4c1e-5d3a-b8cd-afa4dc779e64"))
  (text "I2C bus (IO15 SDA / IO16 SCL, 4.7k pull-ups on sheet MCU):\n  0x20 MCP23017, 0x48 ADS1115 (ADDR = GND), 0x6A LSM6DSO (SA0 = GND).\nADS1115: AIN0 CP level, AIN1 PP, AIN2 / AIN3 spare analog (ANA3 / ANA4).\nLSM6DSO: I2C mode (CS = 3V3); aux SPI pins unused (SDx / SCx to GND).  INT1 -> IO47.\nMount the board square to the vehicle axes."
    (at 20 15 0)
    (effects
      (font
        (size 1.27 1.27))
      (justify left top))
    (uuid "5f3ff8b4-0c7b-5765-bf2e-38c5bffe8034")))
