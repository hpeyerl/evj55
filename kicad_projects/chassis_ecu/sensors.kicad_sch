	(text "I2C bus (IO15 SDA / IO16 SCL, 4.7k pull-ups on sheet MCU): 0x6A LSM6DSO (SA0 = GND).\nLSM6DSO: I2C mode (CS = 3V3); aux SPI pins unused (SDx / SCx to GND).  INT1 -> IO47.\nMount the board square to the vehicle axes.\nAIN1 / AIN2 (J20): 0-15 V -> 0-2.7 V into ESP32 ADC1 (IO8 / IO9), 122k input load."
		(exclude_from_sim no)
		(at 20 15 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "5f3ff8b4-0c7b-5765-bf2e-38c5bffe8034")
	)
