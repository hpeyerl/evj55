  (text "ESP32-S3 module"
    (at 25.4 38.1 0)
    (effects
      (font
        (size 2.54 2.54) bold)
      (justify left top))
    (uuid "e6725704-0dd7-509f-9165-19577fdf09e1"))
  (text "Decoupling, reset, boot, I2C pull-ups"
    (at 25.4 121.92 0)
    (effects
      (font
        (size 2.54 2.54) bold)
      (justify left top))
    (uuid "dcb8bd01-84d6-5935-a89c-d36d7e6e3f79"))
  (text "USB-C (data only) and debug UART"
    (at 25.4 157.48 0)
    (effects
      (font
        (size 2.54 2.54) bold)
      (justify left top))
    (uuid "2b4c8aa7-0116-5e79-a20e-906adfcee8a4"))
  (text "ESP32-S3-WROOM-1-N8 (plastic case, PCB antenna) or -1U-N8 (metal case, u.FL).\nSame pad pattern; the -1 footprint outline covers both.  Keep the antenna end clear of copper.\nStrapping: IO0 = BOOT (button), IO3 / IO45 / IO46 left unconnected.\nUSB: data only (native USB-Serial-JTAG).  VBUS feeds only the ESD part; the board\nruns from 12V, so bench programming needs the 12V supply.\nADC1 (IO1-10) for analog; ADC2 is unusable with WiFi.  No spare GPIO; ANA1/ANA2 (IO4/IO5) go to test pads."
    (at 20 15 0)
    (effects
      (font
        (size 1.27 1.27))
      (justify left top))
    (uuid "96733aac-e717-55a4-83cd-0b0dbfb2162d")))
