  (text "Main connector: Aptiv/FCI HCCPHPE24BKA90F (24-way 90 deg header, key A), mates 211PC249S0005.\nColumns 1 and 8 (A1-C1, A8-C8) = large high-current cavities.  Footprint: lib/ (gen/make_lib.py).\nPawl feed and lead doubled on the large pins.  Pins marked NC: spare."
    (at 20 15 0)
    (effects
      (font
        (size 1.27 1.27))
      (justify left top))
    (uuid "53bf0163-e62c-5efd-90b4-aec27ae561a8")))
